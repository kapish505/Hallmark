PORT=8787
PUBLIC_URL=http://localhost:8787
# ECDSA key of the gateway account (calls createJob, runs the keeper). Never commit the real file.
GATEWAY_PRIVATE_KEY=
# Hedera account id of the same key: x402 payTo and HAPI refund sender
GATEWAY_ACCOUNT_ID=
# leave empty to probe Blocky402 -> Ax402 -> x402.org
FACILITATOR_URL=
VERIFY_SETTLEMENT=true
PRICE_REFRESH_MS=60000
DB_PATH=./data/gateway.sqlite
BLOB_DIR=./data/blobs
MAX_AUDIO_SECONDS=15
MAX_AUDIO_BYTES=1000000
MAX_IMAGE_BYTES=2000000
MAX_IMAGE_PIXELS=4000000
# add-on A1: who besides the buyer and the role operators may read job salts, inputs, outputs (e.g. the challenger)
EVIDENCE_WATCHERS=
# demo only
DEMO_MODE=false
DEMO_CONTROL_TOKEN=
OPERATOR_CONTROL_URLS=
