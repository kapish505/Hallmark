OPERATOR_PRIVATE_KEY=
GATEWAY_URL=http://localhost:8787
# one container per task; leave a task empty if this operator does not serve it
ASR_WORKER_URL=http://localhost:9000
OCR_WORKER_URL=http://localhost:9001
