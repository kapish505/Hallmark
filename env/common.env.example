# Shared by every service. Testnet only. Copy to env/common.env (git-ignored) and fill in after deploying.
RPC_URL=https://testnet.hashio.io/api
CHAIN_ID=296
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
HASHSCAN_URL=https://hashscan.io/testnet
LOG_SOURCE=mirror
HALLMARK_ADDRESS=
JUDGE_ADDRESS=
VERDICT_ADDRESS=
REGISTRY_ADDRESS=
# models served = the manifests in MODELS_DIR (default ./models); MODELS=ASR_V1,OCR_V1 to restrict
MODELS_DIR=models
MODELS=
# explicit gas limits (confirm at G2)
GAS_LIMIT_DEFAULT=400000
GAS_LIMIT_HEAVY=3000000
POLL_MS=2000
