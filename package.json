{
  "name": "hallmark",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:abi": "tsx scripts/gen-abi.ts",
    "gateway": "tsx --env-file=env/common.env --env-file=${ENV_FILE:-env/gateway.env} packages/gateway/src/main.ts",
    "challenger": "tsx --env-file=env/common.env --env-file=${ENV_FILE:-env/challenger.env} packages/operator/src/challenger-main.ts",
    "agent": "tsx --env-file=env/common.env --env-file=${ENV_FILE:-env/agent.env} packages/buyer-agent/src/cli.ts",
    "verify": "tsx --env-file=env/common.env --env-file=${ENV_FILE:-env/agent.env} packages/verifier/src/cli.ts",
    "simulate": "tsx packages/simulator/src/cli.ts",
    "web": "pnpm --filter @hallmark/web dev",
    "calibrate": "tsx scripts/calibrate.ts",
    "operator": "tsx --env-file=env/common.env --env-file=${ENV_FILE:-env/operator.env} packages/operator/src/main.ts",
    "setup:contracts": "sh contracts/install-deps.sh",
    "tunnel": "sh -c 'D=$(grep -s ^NGROK_DOMAIN= env/tunnel.env | cut -d= -f2); [ -n \"$D\" ] || { echo \"put NGROK_DOMAIN=<name>.ngrok-free.app in env/tunnel.env\"; exit 1; }; ngrok http --url=\"$D\" 127.0.0.1:8787'"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/hedera": "2.28.0",
    "ethers": "6.13.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "zod": "3.23.8"
  },
  "version": "0.2.0"
}
